    "version": "0.2.0",
    "configurations": [

        {
            "name": "Base Debug",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/woody_ear/main.go",
            "env": {
                "DYLD_LIBRARY_PATH": "${workspaceFolder}/",
                "CGO_CPPFLAGS": "-I ${workspaceFolder}/pkg/vosk_api",
                "CGO_LDFLAGS": "-L${workspaceFolder}/",
                "MODEL_PATH": "${workspaceFolder}/vosk-model/"
            }
        }
    ]
